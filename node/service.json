{
  "memory": 256,
  "ttl": 10,
  "timeout": 10,
  "minReplicas": 2,
  "maxReplicas": 4,
  "workers": 1,
  "routes": {
    "wishlist": {
      "path": "/_v/private/wishlist",
      "public": true
    },
    "wishlistItems": {
      "path": "/_v/private/wishlist/items",
      "public": true
    },
    "wishlistItem": {
      "path": "/_v/private/wishlist/items/:skuId",
      "public": true
    },
    "wishlistCheck": {
      "path": "/_v/private/wishlist/check",
      "public": true
    }
  }
}
